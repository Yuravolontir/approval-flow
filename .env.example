# LLM Provider Configuration
# stub       = offline deterministic agent (default; used by CI, no key needed)
# openrouter = real LLM via OpenRouter — set LLM_PROVIDER=openrouter and fill LLM_API_KEY
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4-20250514
LLM_BASE_URL=https://openrouter.ai/api/v1

# Autonomy Thresholds (configurable without redeploy)
AUTONOMY_CEILING=250
AUTONOMY_CONFIDENCE=0.80

# Service Ports
GATEWAY_PORT=8080
INVOICE_SERVICE_PORT=5001
WORKFLOW_SERVICE_PORT=5002
PAYMENT_SERVICE_PORT=5003
UI_PORT=3000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
