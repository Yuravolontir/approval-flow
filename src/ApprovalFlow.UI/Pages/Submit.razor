@page "/submit"
@using ApprovalFlow.Shared.Models
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Submit Invoice - ApprovalFlow</PageTitle>

<h1>Submit Invoice</h1>

@if (result != null)
{
    <div class="alert @(result.Status == "Duplicate" ? "alert-warning" : "alert-success") mt-3">
        <strong>Tracking ID:</strong> @result.TrackingId<br />
        <strong>Status:</strong> @result.Status
        @if (!string.IsNullOrEmpty(result.OriginalId))
        {
            <br /><strong>Duplicate of:</strong> @result.OriginalId
        }
    </div>
}

@if (error != null)
{
    <div class="alert alert-danger mt-3">@error</div>
}

<div class="card mt-3">
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Submitter Email</label>
                <input @bind="invoice.Submitter" class="form-control" placeholder="name@company.example" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Department</label>
                <select @bind="invoice.Department" class="form-select">
                    <option value="engineering-2026Q2">Engineering</option>
                    <option value="sales-2026Q2">Sales</option>
                    <option value="marketing-2026Q2">Marketing</option>
                </select>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Vendor</label>
                <input @bind="invoice.Vendor" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Vendor Known</label>
                <select @bind="invoice.VendorKnown" class="form-select">
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Invoice Number</label>
                <input @bind="invoice.InvoiceNumber" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Category</label>
                <select @bind="invoice.Category" class="form-select">
                    <option value="meals">Meals</option>
                    <option value="travel">Travel</option>
                    <option value="saas">SaaS</option>
                    <option value="hardware">Hardware</option>
                    <option value="other">Other</option>
                </select>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <label class="form-label">Currency</label>
                <select @bind="invoice.Currency" class="form-select">
                    <option value="USD">USD</option>
                    <option value="EUR">EUR</option>
                    <option value="GBP">GBP</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Total</label>
                <input @bind="invoice.Total" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Tax Amount</label>
                <input @bind="invoice.TaxAmount" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Attendees</label>
                <input @bind="invoice.Attendees" type="number" class="form-control" />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Line Item Description</label>
                <input @bind="lineDescription" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Qty</label>
                <input @bind="lineQuantity" type="number" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Unit Price</label>
                <input @bind="lineUnitPrice" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-2">
                <div class="form-check mt-4">
                    <input @bind="invoice.ReceiptPresent" type="checkbox" class="form-check-input" id="receipt" />
                    <label class="form-check-label" for="receipt">Receipt</label>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Notes</label>
            <textarea @bind="invoice.Notes" class="form-control" rows="2"></textarea>
        </div>

        <button @onclick="SubmitInvoice" class="btn btn-primary" disabled="@submitting">
            @(submitting ? "Submitting..." : "Submit Invoice")
        </button>
    </div>
</div>

@code {
    private InvoiceDto invoice = new()
    {
        Department = "engineering-2026Q2",
        Currency = "USD",
        Category = "meals",
        VendorKnown = true,
        ReceiptPresent = true,
        Date = DateTime.Now.ToString("yyyy-MM-dd")
    };

    private string lineDescription = "";
    private int lineQuantity = 1;
    private decimal lineUnitPrice = 0;
    private bool submitting = false;
    private SubmitInvoiceResponse? result;
    private string? error;

    private async Task SubmitInvoice()
    {
        submitting = true;
        result = null;
        error = null;

        try
        {
            invoice.LineItems = new List<LineItemDto>
            {
                new() { Description = lineDescription, Quantity = lineQuantity, UnitPrice = lineUnitPrice }
            };

            var client = HttpClientFactory.CreateClient("Gateway");
            var response = await client.PostAsJsonAsync("/api/invoices", invoice);

            if (response.IsSuccessStatusCode)
            {
                result = await response.Content.ReadFromJsonAsync<SubmitInvoiceResponse>();
            }
            else
            {
                error = $"Error: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            error = $"Failed to submit: {ex.Message}";
        }
        finally
        {
            submitting = false;
        }
    }
}
