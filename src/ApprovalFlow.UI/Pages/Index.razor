@page "/"
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Dashboard - ApprovalFlow</PageTitle>

<h1>ApprovalFlow Dashboard</h1>

@if (dashboard != null)
{
    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Processed</h5>
                    <p class="card-text display-6">@dashboard.TotalProcessed</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success mb-3">
                <div class="card-body">
                    <h5 class="card-title">Auto-Approved</h5>
                    <p class="card-text display-6">@dashboard.AutoApproved</p>
                    <small>$@dashboard.TotalAutoApprovedAmount.ToString("F2")</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning mb-3">
                <div class="card-body">
                    <h5 class="card-title">Human Reviewed</h5>
                    <p class="card-text display-6">@dashboard.HumanReviewed</p>
                    <small>$@dashboard.TotalHumanReviewedAmount.ToString("F2")</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-danger mb-3">
                <div class="card-body">
                    <h5 class="card-title">Rejected</h5>
                    <p class="card-text display-6">@dashboard.Rejected</p>
                </div>
            </div>
        </div>
    </div>
}
else if (error != null)
{
    <div class="alert alert-warning mt-3">@error</div>
}
else
{
    <p class="mt-3"><em>Loading dashboard...</em></p>
}

@code {
    private ApprovalFlow.Shared.Models.DashboardResponse? dashboard;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("Gateway");
            dashboard = await client.GetFromJsonAsync<ApprovalFlow.Shared.Models.DashboardResponse>("/api/dashboard");
        }
        catch (Exception ex)
        {
            error = $"Could not load dashboard: {ex.Message}";
        }
    }
}
